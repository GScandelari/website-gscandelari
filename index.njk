            <img src="imgs/cms-logo.png" alt="CMS do Blog" class="h-full w-full object-contain p-4" />
            <span class="absolute top-3 right-3 text-xs px-2 py-0.5 bg-green-500/10 text-green-400 rounded-full border border-green-500/20 font-medium">Produção</span>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class="text-xs px-2 py-0.5 bg-orange-500/10 text-orange-400 rounded-full border border-orange-500/20">Firebase</span>
