---
layout: base.njk
---
<section class="pt-32 pb-12">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-4">
      <span class="inline-block text-xs font-semibold tracking-widest text-blue-400 uppercase mb-4" data-i18n="blog.hero.eyebrow">
        Publicações
      </span>
      <h1 class="text-4xl lg:text-5xl font-bold mb-6">
        <span data-i18n="blog.hero.heading.before">Meu </span><span class="gradient-text" data-i18n="blog.hero.heading.gradient">Blog</span>
      </h1>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto" data-i18n="blog.hero.desc">
        Artigos, estudos e materiais sobre desenvolvimento, TI e tecnologia.
      </p>
    </div>
  </div>
</section>

{% if collections.postTags and collections.postTags.length %}
<section class="pb-8">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs text-gray-500 uppercase tracking-widest mr-2" data-i18n="blog.tags.filter">Filtrar por tag</span>
      <a href="/blog/"
         class="tag-filter-btn text-xs px-3 py-1 rounded-full border border-white/10 text-gray-300 hover:border-white/20 transition-colors{% if not filterTag %} active{% endif %}"
         data-i18n="blog.tags.all">Todos</a>
      {% for tag in collections.postTags %}
      <a href="/blog/tags/{{ tag }}/"
         class="tag-filter-btn text-xs px-3 py-1 rounded-full border border-white/10 text-gray-300 hover:border-white/20 transition-colors{% if filterTag == tag %} active{% endif %}">{{ tag }}</a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="pb-24">
  <div class="max-w-5xl mx-auto px-6">
    {% if filterTag %}
    <p class="text-sm text-gray-500 mb-6">
      <span data-i18n="blog.tags.filter">Filtrar por tag</span>:
      <span class="text-blue-400">{{ filterTag }}</span>
    </p>
    {% endif %}

    {% if filterTag %}
      {% set postList = collections.posts | filterByTag(filterTag) %}
    {% else %}
      {% set postList = posts %}
    {% endif %}

    <div id="posts-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for post in postList %}
      <article class="post-card group bg-white/3 border border-white/8 rounded-2xl overflow-hidden card-hover">
        <div class="p-5 flex flex-col h-full">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            {% for tag in post.data.tags %}
              {% if tag != 'posts' %}
              <a href="/blog/tags/{{ tag }}/" class="text-xs px-2 py-0.5 bg-blue-500/10 text-blue-400 rounded-full border border-blue-500/20 hover:border-blue-500/40 transition-colors">{{ tag }}</a>
              {% endif %}
            {% endfor %}
          </div>
          <time class="text-xs text-gray-500 mb-2" datetime="{{ post.date | isoDate }}" data-i18n-date>{{ post.date | dateDisplay("pt-BR") }}</time>
          <h2 class="font-semibold text-white mb-2 text-lg leading-snug">
            <a href="{{ post.url }}" data-pt-href="{{ post.url }}" data-pt-text="{{ post.data.title }}"{% if post.data.enUrl %} data-en-href="{{ post.data.enUrl }}"{% endif %}{% if post.data.enTitle %} data-en-text="{{ post.data.enTitle }}"{% endif %} class="hover:text-blue-400 transition-colors">{{ post.data.title }}</a>
          </h2>
          <p class="text-gray-400 text-sm leading-relaxed mb-4 flex-1" data-pt-text="{{ post.data.description | excerpt }}"{% if post.data.enDescription %} data-en-text="{{ post.data.enDescription | excerpt }}"{% endif %}>
            {{ post.data.description | excerpt }}
          </p>
          <a href="{{ post.url }}" data-pt-href="{{ post.url }}"{% if post.data.enUrl %} data-en-href="{{ post.data.enUrl }}"{% endif %} class="text-xs text-blue-400 hover:text-blue-300 transition-colors inline-flex items-center gap-1 mt-auto">
            <span data-i18n="blog.read.more">Ler artigo</span> <i class="fas fa-arrow-right text-[10px]"></i>
          </a>
        </div>
      </article>
      {% else %}
      <p class="text-gray-500 col-span-full text-center py-12">Nenhum post publicado ainda.</p>
      {% endfor %}
    </div>

    {% if pagination and pagination.pages.length > 1 and not filterTag %}
    <nav class="flex items-center justify-center gap-4 mt-12" aria-label="Paginação">
      {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="text-sm text-gray-400 hover:text-white border border-white/10 hover:border-white/20 transition-all px-4 py-2 rounded-xl">← Anterior</a>
      {% endif %}
      <span class="text-sm text-gray-500">{{ pagination.pageNumber + 1 }} / {{ pagination.pages.length }}</span>
      {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="text-sm text-gray-400 hover:text-white border border-white/10 hover:border-white/20 transition-all px-4 py-2 rounded-xl">Próxima →</a>
      {% endif %}
    </nav>
    {% endif %}
  </div>
</section>
