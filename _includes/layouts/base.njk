<!DOCTYPE html>
<html lang="{% if lang == 'en' %}en{% else %}pt-BR{% endif %}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | Guilherme Scandelari</title>
  <meta name="description" content="{{ description or site.description }}" />
  {% if keywords %}<meta name="keywords" content="{{ keywords }}" />{% endif %}

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }} | Guilherme Scandelari" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}" />
  <meta property="og:type" content="{% if pageType == 'post' %}article{% else %}website{% endif %}" />
  <meta property="og:image" content="{{ ogImage or (site.url + '/imgs/logo.png') }}" />
  <meta property="og:site_name" content="{{ site.title }}" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-1G1Q9SPLJQ"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1G1Q9SPLJQ');
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/favicon/android-chrome-512x512.png">
  <link rel="manifest" href="/favicon/site.webmanifest">

  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} Blog" href="/blog/feed.xml">

  <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
  <link rel="stylesheet" href="/css/tailwind.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    html { scroll-behavior: smooth; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
    .gradient-text {
      background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .card-hover {
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .card-hover:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(59,130,246,.15);
    }
    .nav-link { position: relative; }
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 2px;
      background: #3B82F6;
      transition: width .25s ease;
    }
    .nav-link:hover::after { width: 100%; }

    body::before {
      content: '';
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 80%;
      max-width: 800px;
      height: 80%;
      background-image: url('/imgs/logo.png');
      background-position: center;
      background-repeat: no-repeat;
      background-size: contain;
      opacity: 0.15;
      pointer-events: none;
      z-index: 0;
    }
    body > *:not(nav) { position: relative; z-index: 1; }

    .post-content {
      color: #cbd5e1;
      line-height: 1.85;
      font-size: 1.125rem;
      letter-spacing: 0.01em;
    }
    .post-content > p:first-of-type {
      color: #e2e8f0;
      font-size: 1.2rem;
      line-height: 1.75;
      margin-bottom: 2rem;
    }
    .post-content h2 {
      color: #fff;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin: 3rem 0 1rem;
      padding-top: 0.25rem;
      scroll-margin-top: 5.5rem;
    }
    .post-content h2::before {
      content: '';
      display: block;
      width: 2.5rem;
      height: 2px;
      margin-bottom: 0.85rem;
      background: linear-gradient(90deg, #3B82F6, #8B5CF6);
      border-radius: 999px;
    }
    .post-content h3 {
      color: #f1f5f9;
      font-size: 1.2rem;
      font-weight: 600;
      margin: 2.25rem 0 0.75rem;
      scroll-margin-top: 5.5rem;
    }
    .post-content p { margin-bottom: 1.35rem; }
    .post-content a {
      color: #60a5fa;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      transition: color .2s ease;
    }
    .post-content a:hover { color: #93c5fd; }
    .post-content ul, .post-content ol {
      margin: 0 0 1.5rem;
      padding-left: 0;
      display: grid;
      gap: 0.65rem;
    }
    .post-content li {
      position: relative;
      padding-left: 1.35rem;
      color: #cbd5e1;
    }
    .post-content ul > li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.7em;
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 999px;
      background: #3B82F6;
      box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
    }
    .post-content ol {
      counter-reset: post-ol;
    }
    .post-content ol > li {
      counter-increment: post-ol;
    }
    .post-content ol > li::before {
      content: counter(post-ol);
      position: absolute;
      left: 0;
      top: 0.15em;
      font-size: 0.75rem;
      font-weight: 600;
      color: #60a5fa;
    }
    .post-content blockquote {
      border-left: 3px solid #3B82F6;
      background: rgba(59,130,246,0.06);
      border-radius: 0 0.75rem 0.75rem 0;
      padding: 1rem 1.25rem;
      margin: 2rem 0;
      color: #e2e8f0;
      font-style: italic;
    }
    .post-content pre {
      margin: 1.75rem 0;
      padding: 1.15rem 1.25rem;
      border-radius: 0.9rem;
      overflow-x: auto;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(2,6,23,0.65) !important;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
    }
    .post-content pre[class*="language-"] {
      margin: 1.75rem 0;
      padding: 1.15rem 1.25rem;
      background: rgba(2,6,23,0.65);
    }
    .post-content code { font-size: 0.875em; }
    .post-content :not(pre) > code {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 0.375rem;
      padding: 0.15rem 0.4rem;
      color: #e5e7eb;
    }
    .post-content img {
      display: block;
      border-radius: 1rem;
      margin: 2rem auto;
      max-width: 100%;
      border: 1px solid rgba(255,255,255,0.08);
    }
    .post-content hr {
      border: 0;
      border-top: 1px solid rgba(255,255,255,0.08);
      margin: 2.75rem 0;
    }
    .post-content table {
      display: block;
      width: 100%;
      margin: 2rem 0;
      border-collapse: collapse;
      font-size: 0.95rem;
      /* Markdown output has no wrapper div to make scrollable instead —
         display:block + overflow-x on the <table> itself is the standard
         trick for that. Its table-row-group/row/cell children keep their
         own display values, so the actual column layout/alignment is
         unaffected — only the outer table becomes a scroll container. */
      overflow-x: auto;
    }
    .post-content th,
    .post-content td {
      padding: 0.7rem 1rem;
      border: 1px solid rgba(255,255,255,0.08);
      text-align: left;
      vertical-align: top;
    }
    .post-content th {
      background: rgba(59,130,246,0.08);
      color: #fff;
      font-weight: 600;
      white-space: nowrap;
    }
    .post-content tbody tr:nth-child(even) {
      background: rgba(255,255,255,0.02);
    }
    .tag-filter-btn.active {
      background: rgba(59,130,246,0.2);
      border-color: rgba(59,130,246,0.4);
      color: #60a5fa;
    }
    .post-card[hidden] { display: none !important; }

    body.page-post::before { opacity: 0.06; }
    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 5px;
      width: 0;
      z-index: 100;
      background: linear-gradient(90deg, #3B82F6, #8B5CF6);
      box-shadow: 0 0 12px rgba(59,130,246,0.45);
      transition: width .05s linear;
    }
    .post-enter {
      animation: postEnter .55s ease both;
    }
    @keyframes postEnter {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body class="bg-gray-950 text-white font-sans antialiased{% if pageType == 'post' %} page-post{% endif %}">

  {% if pageType == 'post' %}
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  {% endif %}

  <nav class="fixed top-0 inset-x-0 z-50 bg-gray-950/80 backdrop-blur border-b border-white/5">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="font-semibold tracking-tight text-white hover:text-blue-400 transition-colors">
        GScandelari
      </a>
      <div class="hidden sm:flex items-center gap-6 text-sm text-gray-400">
        <a href="/#sobre" class="nav-link hover:text-white transition-colors" data-i18n="nav.about">Sobre</a>
        <a href="/#servicos" class="nav-link hover:text-white transition-colors" data-i18n="nav.services">Serviços</a>
        <a href="/carreira" class="nav-link hover:text-white transition-colors" data-i18n="nav.career">Carreira</a>
        <a href="/formacao" class="nav-link hover:text-white transition-colors" data-i18n="nav.education">Formação</a>
        <a href="/#projetos" class="nav-link hover:text-white transition-colors" data-i18n="nav.projects">Projetos</a>
        <a href="/blog/" class="nav-link hover:text-white transition-colors{% if page.url and '/blog' in page.url %} text-white{% endif %}" data-i18n="nav.blog">Blog</a>
        <a href="/#contato" class="nav-link hover:text-white transition-colors" data-i18n="nav.contact">Contato</a>
      </div>
      <div class="flex items-center gap-3">
        <button id="lang-toggle" class="text-xs font-semibold text-gray-400 hover:text-white transition-colors border border-white/10 hover:border-white/20 px-2.5 py-1 rounded-md">EN</button>
        <a href="/#contato"
           class="text-sm bg-blue-600 hover:bg-blue-500 transition-colors px-4 py-2 rounded-lg font-medium"
           data-i18n="nav.cta">
          Fale comigo
        </a>
      </div>
    </div>
  </nav>

  {{ content | safe }}

  <footer class="border-t border-white/5 py-8">
    <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-gray-600 text-sm" data-i18n="footer.rights.short">
        © 2026 Guilherme Scandelari. Todos os direitos reservados.
      </span>
      <div class="flex items-center gap-5 text-gray-600">
        <a href="https://github.com/GScandelari" target="_blank" rel="noopener noreferrer"
           class="hover:text-white transition-colors text-lg"><i class="fab fa-github"></i></a>
        <a href="https://www.linkedin.com/in/guilherme-stanke-scandelari/?locale=pt-BR" target="_blank" rel="noopener noreferrer"
           class="hover:text-blue-400 transition-colors text-lg"><i class="fab fa-linkedin"></i></a>
        <a href="https://wa.me/5541985154041" target="_blank" rel="noopener noreferrer"
           class="hover:text-green-400 transition-colors text-lg"><i class="fab fa-whatsapp"></i></a>
        <a href="mailto:scandelari.guilherme@hotmail.com"
           class="hover:text-white transition-colors text-lg"><i class="fas fa-envelope"></i></a>
      </div>
    </div>
  </footer>

  <script src="/js/i18n.js" defer></script>
</body>
</html>
