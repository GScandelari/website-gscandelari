---
permalink: /blog/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}: Blog</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/blog/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/blog/" rel="alternate" type="text/html"/>
  <updated>{% if collections.posts.length %}{{ collections.posts[0].date | isoDate }}{% else %}2026-08-16T00:00:00.000Z{% endif %}</updated>
  <id>{{ site.url }}/blog/</id>
  <author>
    <name>{{ site.author.name }}</name>
    <email>{{ site.author.email }}</email>
  </author>
  {% for post in collections.posts %}
  {% if loop.index0 < 20 %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absoluteUrl(site.url) }}" rel="alternate" type="text/html"/>
    <published>{{ post.date | isoDate }}</published>
    <updated>{{ post.date | isoDate }}</updated>
    <id>{{ post.url | absoluteUrl(site.url) }}</id>
    <author>
      <name>{{ site.author.name }}</name>
    </author>
    <summary>{{ post.data.description }}</summary>
  </entry>
  {% endif %}
  {% endfor %}
</feed>
