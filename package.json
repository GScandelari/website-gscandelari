{
  "name": "gscandelari",
  "version": "1.0.0",
  "description": "Site pessoal de Guilherme Stanke Scandelari, hospedado em [gscandelari.com.br](https://gscandelari.com.br).",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/tailwind.css --watch",
    "build:site": "eleventy",
    "build": "npm run build:css && npm run build:site && node scripts/hash-assets.js",
    "serve": "eleventy --serve",
    "new:post": "node scripts/new-post.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@tailwindcss/cli": "^4.2.2",
    "tailwindcss": "^4.2.2"
  }
}
